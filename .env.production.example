# =====================================================
# ReachInbox Email Scheduler — PRODUCTION .env
# Copy this to .env on your EC2 instance
# Fill in ALL values before running docker compose
# NEVER commit this file to Git
# =====================================================

# ─── Server ───────────────────────────────────────
PORT=5000
NODE_ENV=production

# Frontend origin (GitHub Pages URL)
# Format: https://<username>.github.io/<repo-name>
CLIENT_URL=https://YOUR_GITHUB_USERNAME.github.io/reachinbox-email-scheduler

# ─── PostgreSQL ────────────────────────────────────
# These are used by docker-compose.prod.yml
POSTGRES_USER=reachinbox
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=reachinbox_scheduler

# Full connection string (uses Docker service name 'postgres')
DATABASE_URL=postgresql://reachinbox:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/reachinbox_scheduler

# ─── Redis ─────────────────────────────────────────
# Uses Docker service name 'redis'
REDIS_URL=redis://redis:6379

# ─── Elasticsearch ─────────────────────────────────
# Uses Docker service name 'elasticsearch'
ELASTICSEARCH_URL=http://elasticsearch:9200

# ─── JWT Authentication ────────────────────────────
# MUST be at least 32 characters, cryptographically random
# Generate: openssl rand -hex 32
JWT_SECRET=GENERATE_WITH_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# ─── Ethereal SMTP ─────────────────────────────────
# Leave blank to auto-generate a fresh Ethereal test account on startup
# OR set static credentials from https://ethereal.email
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=

# ─── Email Scheduling & Rate Limiting ─────────────
MAX_EMAILS_PER_HOUR=100
EMAIL_MIN_DELAY_MS=2000
WORKER_CONCURRENCY=5

# ─── Google OAuth 2.0 ──────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials
# Authorized redirect URI: https://YOUR_DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://YOUR_DOMAIN/api/auth/google/callback

# ─── Slack OAuth ───────────────────────────────────
# From api.slack.com/apps → OAuth & Permissions
# Redirect URL: https://YOUR_DOMAIN/api/slack/callback
# Bot Scopes: chat:write, incoming-webhook
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=https://YOUR_DOMAIN/api/slack/callback
