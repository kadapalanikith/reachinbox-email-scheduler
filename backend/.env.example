# ==========================================
# ReachInbox Email Scheduler Environment Config
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://reachinbox:reachinbox_secret_password@localhost:5432/reachinbox_scheduler

# Redis (BullMQ, Rate Limiting, Idempotency Locks)
REDIS_URL=redis://localhost:6379

# Elasticsearch (Full-text email search)
ELASTICSEARCH_URL=http://localhost:9200

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_reachinbox_dev_min_32_chars_123456789
JWT_EXPIRES_IN=7d

# Ethereal SMTP (Leave blank to auto-generate a real Ethereal account on boot)
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=

# Email Scheduling & Rate Limiting Configuration
MAX_EMAILS_PER_HOUR=100
EMAIL_MIN_DELAY_MS=2000
WORKER_CONCURRENCY=10

# Google OAuth 2.0 (From Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Slack OAuth (From api.slack.com/apps -> OAuth & Permissions)
# Redirect URL: http://localhost:5000/api/slack/callback
# User Scopes / Bot Scopes: chat:write, incoming-webhook
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback
