datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}

model User {
  id              String           @id @default(uuid())
  googleId        String?          @unique
  email           String           @unique
  name            String
  avatar          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  senders         Sender[]
  campaigns       Campaign[]
  slackConnection SlackConnection?

  @@index([email])
}

model Sender {
  id        String   @id @default(uuid())
  userId    String
  email     String
  name      String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails    Email[]

  @@index([userId])
  @@index([email])
}

model Campaign {
  id          String   @id @default(uuid())
  userId      String
  subject     String
  body        String
  startTime   DateTime
  delayMs     Int      @default(2000)
  hourlyLimit Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails      Email[]

  @@index([userId])
  @@index([createdAt])
}

model Email {
  id                 String      @id @default(uuid())
  campaignId         String
  senderId           String
  recipient          String
  subject            String
  body               String
  scheduledAt        DateTime
  sentAt             DateTime?
  status             EmailStatus @default(SCHEDULED)
  bullJobId          String?
  idempotencyKey     String      @unique
  attempts           Int         @default(0)
  errorMessage       String?
  etherealPreviewUrl String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  campaign           Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sender             Sender      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([senderId])
  @@index([status, scheduledAt])
  @@index([recipient])
}

model SlackConnection {
  id          String   @id @default(uuid())
  userId      String   @unique
  accessToken String
  teamId      String
  teamName    String
  channelId   String?
  channelName String?
  webhookUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
